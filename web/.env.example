# Base URL of the MusicArea Flask API. Server components fetch from this
# server-to-server. In local dev, point at the Flask dev server; in production,
# point at the separately deployed Flask service (Render/Railway).
FLASK_API_BASE=http://127.0.0.1:5000

# Public origin of this Next.js frontend, used for canonical URLs, sitemap and
# Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
