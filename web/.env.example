# Base URL of the MusicArea Flask API. Read on the server only, by
# src/lib/api.ts. Deliberately not NEXT_PUBLIC_: browser code reaches the API
# through the route handlers in src/app/api/ instead, so this host is never
# shipped to the client. In local dev, point at the Flask dev server; in
# production, point at the separately deployed Flask service.
FLASK_API_BASE=http://127.0.0.1:5000

# Public origin of this Next.js frontend, used for canonical URLs, the sitemap
# and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
